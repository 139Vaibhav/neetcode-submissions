    {
      "id": "S2EEdRYZViYBwq0Wael8i",
      "type": "text",
      "x": 1083.7183515867084,
      "y": 3025.8001821992534,
      "width": 55.24394950258871,
      "height": 84.11076642044826,
      "angle": 0,
