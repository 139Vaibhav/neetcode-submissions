    },
    {
      "id": "SrYfJ3avXFWNQnSCOTbRB",
      "type": "text",
      "x": 1088.2737347969328,
      "y": 3115.769000601179,
      "width": 891.5959448439754,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1l",
      "roundness": null,
      "seed": 2024610604,
      "version": 897,
      "versionNonce": 1912063276,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794407750939,
      "created": 1794406755581,
      "link": null,
      "locked": false,
      "text": "pseudo code\n\nList<List<Integer>> adj = new ArrayList<>();\nfor(int I=0;i<n;i++)\n    adj.add(new ArrayList<>());\nboolean vis[] = new vis[n];\nreturn isCycleDFS(adj, vis, 0, -1);\n\nboolean isCycleDFS(List<List<Integer>> adj, boolean[] vis, int src, int parent){\n    vis[src]=true;\n    for(int neighbour : adj.get(src)){\n        if(!vis[neighbour]){\n            if(isCycleDFS(adj, vis, neighbour, src)) return true;\n        }\n        else if(neighbour != parent){\n            return true;\n        }\n    }\n    return false;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pseudo code\n\nList<List<Integer>> adj = new ArrayList<>();\nfor(int I=0;i<n;i++)\n    adj.add(new ArrayList<>());\nboolean vis[] = new vis[n];\nreturn isCycleDFS(adj, vis, 0, -1);\n\nboolean isCycleDFS(List<List<Integer>> adj, boolean[] vis, int src, int parent){\n    vis[src]=true;\n    for(int neighbour : adj.get(src)){\n        if(!vis[neighbour]){\n            if(isCycleDFS(adj, vis, neighbour, src)) return true;\n        }\n        else if(neighbour != parent){\n            return true;\n        }\n    }\n    return false;\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SvpjeHr_C0NVa3O3SdFUg",
      "type": "text",
      "x": 1087.720352121685,
      "y": 3713.7442653154253,
      "width": 33,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1m",
      "roundness": null,
      "seed": 949081132,
      "version": 19,
      "versionNonce": 482903596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794407424746,
      "created": 1794407418543,
      "link": null,
      "locked": false,
      "text": "BFS\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BFS\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "elu0rH-Yx0nZDo9JOYViG",
      "type": "text",
      "x": 1109.600430848628,
      "y": 3777.0219146079503,
      "width": 1076.0600004325365,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 349676972,
      "version": 657,
      "versionNonce": 689010092,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794408644098,
      "created": 1794407442352,
      "link": null,
      "locked": false,
      "text": "pseudo code\n\nboolean isCycleBFS(List<List<Integer>> adj, boolean[] vis, int src){\n    Queue<int[]> q = new LinkedList<>(); // in the queue, put the source and the parent\n    q.add(new int[]{src, -1});\n    vis[src]=true;\n    while(!q.isEmpty()){\n        int[] x = q.poll();\n        for(int neighbour : x[0]){\n            if(!vis[neighbour])\n                q.add(new int[]{neighbour,x[0]});\n            else if(neighbour != x[1])\n                return true;\n        }\n    }\n    return false;\n}\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pseudo code\n\nboolean isCycleBFS(List<List<Integer>> adj, boolean[] vis, int src){\n    Queue<int[]> q = new LinkedList<>(); // in the queue, put the source and the parent\n    q.add(new int[]{src, -1});\n    vis[src]=true;\n    while(!q.isEmpty()){\n        int[] x = q.poll();\n        for(int neighbour : x[0]){\n            if(!vis[neighbour])\n                q.add(new int[]{neighbour,x[0]});\n            else if(neighbour != x[1])\n                return true;\n        }\n    }\n    return false;\n}\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
