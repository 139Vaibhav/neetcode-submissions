      "version": 483,
      "versionNonce": 86946196,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794409121361,
      "created": 1794408785930,
      "link": null,
      "locked": false,
      "text": "boolean isCycleDFS(List<List<Integer>> adj, boolean vis[], int src, boolean[] pathVis){\n    vis[src]=true;\n    pathVis[src]=true;\n    for(int neighbour : adj.get(src)){\n        if(!vis[neighbour]){\n            if(isCycleDFS(adj, vis, neighbour, pathVis)) return true;\n        } else if(pathVis[neighbour]) return true;\n    }\n    pathVis[src]=false;\n    return false;\n} ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "boolean isCycleDFS(List<List<Integer>> adj, boolean vis[], int src, boolean[] pathVis){\n    vis[src]=true;\n    pathVis[src]=true;\n    for(int neighbour : adj.get(src)){\n        if(!vis[neighbour]){\n            if(isCycleDFS(adj, vis, neighbour, pathVis)) return true;\n        } else if(pathVis[neighbour]) return true;\n    }\n    pathVis[src]=false;\n    return false;\n} ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
