    {
      "id": "d-qLL6MdTz9zcBuQstyc9",
      "type": "text",
      "x": 1092.037233143605,
      "y": 4978.053158257205,
      "width": 616,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2E",
      "roundness": null,
      "seed": 685580820,
      "version": 622,
      "versionNonce": 1410566060,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794411488491,
      "created": 1794410734532,
      "link": null,
      "locked": false,
      "text": "boolean isCycleBFS(List<List<Integer>> adj, int n){\n    int[] inDegree = new int[n];\n    for(int i=0;i<n;i++){\n        for(int neighbour : adj.get(i))\n            inDegree[neighbour]++;\n    }\n    Queue<Integer> q = new LinkedList<>();\n    for(int i=0;i<n;i++){\n        if(inDegree[i]==0) q.add(i);\n    }\n    int count=0;\n    while(!q.isEmpty()){\n        int src = q.poll();\n        count++;\n        for(int neighbour : adj.get(src)){\n            inDegree[neighbour]--;\n            if(inDegree[neighbour]==0) q.add(neighbour);\n        }\n    }\n    return count!=n;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "boolean isCycleBFS(List<List<Integer>> adj, int n){\n    int[] inDegree = new int[n];\n    for(int i=0;i<n;i++){\n        for(int neighbour : adj.get(i))\n            inDegree[neighbour]++;\n    }\n    Queue<Integer> q = new LinkedList<>();\n    for(int i=0;i<n;i++){\n        if(inDegree[i]==0) q.add(i);\n    }\n    int count=0;\n    while(!q.isEmpty()){\n        int src = q.poll();\n        count++;\n        for(int neighbour : adj.get(src)){\n            inDegree[neighbour]--;\n            if(inDegree[neighbour]==0) q.add(neighbour);\n        }\n    }\n    return count!=n;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
